# Copiar a .env y regenerar los secretos antes de usar:
#   openssl rand -hex 32   -> LIVEKIT_API_SECRET
#
# .env esta en .gitignore. Nunca commitear secretos reales.

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=cambiame-openssl-rand-hex-32

# Recording (issues #5, #58): a Google Cloud Storage DEV bucket, never the
# production one. There is no GCS emulator Egress can upload to. Leave both
# empty to run LiveKit without recording (README.md, "Grabacion local").
#
# Absolute path to an Application Default Credentials JSON that can write to
# GCS_BUCKET, normally the impersonated one written by
# `gcloud auth application-default login --impersonate-service-account=...`
# (~/.config/gcloud/application_default_credentials.json). Keep it OUTSIDE
# the repository.
GCS_CREDENTIALS_FILE=
GCS_BUCKET=
