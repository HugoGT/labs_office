# Copiar a terraform.tfvars y rellenar. El fichero real NO se commitea: no
# lleva secretos, pero fija el proyecto y el correo de contacto y cada entorno
# tendra el suyo.
#
#   cp terraform.tfvars.example terraform.tfvars

project_id = "vaulted-channel-505114-f0"
acme_email = "cambiar@ejemplo.com"

# Los demas valores tienen default en variables.tf y solo se tocan para crear
# un entorno distinto de test.
#
# env               = "test"
# region            = "us-central1"
# zone              = "us-central1-a"
# machine_type      = "e2-medium"
#
# Recording (issues #5, #58): on e2-medium Egress refuses every recording
# (502 egress-failed), on purpose, so it cannot starve the SFU. One concurrent
# recording needs 4 vCPU; see "Recordings" in infra/gcp/README.md.
# machine_type = "e2-standard-4"
# boot_disk_size_gb = 20
# github_repository = "HugoGT/labs_office"

# Tag de imagenes. Se deja vacio: lo fija el workflow de despliegue en cada
# push, no una edicion manual de este fichero.
# image_tag = ""

# Autenticacion (issue #8). Descomentar SOLO despues de habilitar Identity
# Platform y crear al menos una cuenta (ver infra/gcp/README.md): en cuanto
# tenga valor, el servidor deja de aceptar a quien no traiga un ID token valido.
# auth_project_id = "vaulted-channel-505114-f0"

# Directorio y panel de administracion (issue #24). El correo se promociona a
# superadmin en su PRIMER inicio de sesion, y solo mientras no exista ya uno.
# La cuenta tiene que existir antes en Identity Platform (el issue #8 desactivo
# el alta por cuenta propia): si no, nadie podra hacer el arranque en frio.
# bootstrap_superadmin_email = "gthugo@outlook.com"

# Activar solo cuando exista la cuenta de servicio de Identity Platform con la
# que el servidor da de alta cuentas al aceptar una invitacion. Mientras este
# en false, el panel funciona entero salvo el endpoint de invitar, que responde
# 503 (ver infra/gcp/README.md).
# enable_identity_admin_secret = true
