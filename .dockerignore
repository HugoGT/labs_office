# Contexto de build de las dos imagenes de infra/gcp/docker/. Cuanto menos
# entra, menos tarda el envio del contexto y menos se invalida el cache.

node_modules
**/node_modules

# Salidas de build: se regeneran dentro de la imagen. Copiar el dist de la
# maquina de quien construye seria ademas la forma mas facil de desplegar un
# bundle que nadie ha vuelto a compilar.
dist
dist-e2e
coverage
.vitest-reports
.vitest-attachments
**/__screenshots__

# Ni las pruebas ni el historial de git influyen en lo que se sirve.
**/*.test.ts
**/*.test.tsx
e2e
.git
.github

# Entornos locales. Los secretos del despliegue vienen de Secret Manager, nunca
# de un fichero del contexto.
.env
.env.*
!.env.example

# Infraestructura. La excepcion es la carpeta docker/: web.Dockerfile copia
# desde ahi la configuracion de nginx.
infra/livekit
prototype

.atl
.codegraph
.vscode
.idea
