{
  "name": "oficina-virtual",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "description": "Oficina Virtual — cliente PWA (PRD seccion 6.1). Fase 0.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:browser": "vitest run --project=browser",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "server": "node server/src/main.ts",
    "test:server": "vitest run --project=server",
    "test:harness": "node --test e2e/preview-url.test.mjs",
    "test:e2e": "node --test e2e/bundle-hook-absent.e2e.test.mjs e2e/two-client-proximity.e2e.test.mjs e2e/two-client-audio.e2e.test.mjs",
    "e2e": "pnpm test:harness && pnpm build && pnpm build:e2e && pnpm test:e2e"
  },
  "dependencies": {
    "@colyseus/core": "0.16.24",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "~0.16.5",
    "colyseus.js": "0.16.22",
    "express": "^4.22.2",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.18.0",
    "phaser": "3.90.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@colyseus/testing": "0.16.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  }
}
